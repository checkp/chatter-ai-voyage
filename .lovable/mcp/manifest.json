{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/agent-mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vczxurigjttwxwilosjz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "chatter-ai-voyage",
      "version": "0.2.0",
      "title": "chatter-ai-voyage"
    },
    "tools": [
      {
        "name": "list_models",
        "title": "List available models",
        "description": "List RoboHeard's AI platforms (OpenAI, Anthropic, Google, xAI, DeepSeek, Mistral, Perplexity, Qwen, NVIDIA), their model ids and cost tiers, and which advanced capabilities (think, search, deep_research, code_exec) each supports. Call first to discover what to route to.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_chats",
        "title": "List chats",
        "description": "List the signed-in user's most recent conversations, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many conversations to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_chat",
        "title": "Get chat messages",
        "description": "Read the messages of one of the signed-in user's conversations, including which AI platform produced each reply.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "chat_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The conversation id, as returned by list_chats."
            },
            "limit": {
              "description": "How many messages to return (default 50, newest last).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "chat_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_messages",
        "title": "Search messages",
        "description": "Full-text-ish search across the signed-in user's chat messages, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Text to look for inside message content."
            },
            "limit": {
              "description": "How many matches to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "ask_model",
        "title": "Ask a single AI model",
        "description": "Send a prompt to ONE AI model through RoboHeard — fastest and cheapest path. Optionally enable advanced capabilities (think, search, deep_research, code_exec) and continue an existing conversation. Consumes the signed-in user's tokens and persists to chat history. Use list_models to discover valid model ids.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "platform": {
              "type": "string",
              "enum": [
                "openai",
                "anthropic",
                "google",
                "grok",
                "deepseek",
                "perplexity",
                "mistral",
                "qwen",
                "nvidia"
              ],
              "description": "Which provider to route the prompt to."
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "description": "The user prompt to send."
            },
            "model": {
              "description": "Optional explicit model id; the platform default is used otherwise.",
              "type": "string",
              "minLength": 1
            },
            "system": {
              "description": "Optional system instruction.",
              "type": "string",
              "minLength": 1
            },
            "capabilities": {
              "description": "Advanced capabilities to enable for supported models.",
              "type": "object",
              "properties": {
                "think": {
                  "type": "boolean"
                },
                "search": {
                  "type": "boolean"
                },
                "deep_research": {
                  "type": "boolean"
                },
                "code_exec": {
                  "type": "boolean"
                }
              }
            },
            "conversation_id": {
              "description": "Optional existing RoboHeard conversation to continue.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "platform",
            "prompt"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "web_search",
        "title": "Live web search with citations",
        "description": "Live web search grounded in real-time results with numbered source citations, powered by Perplexity Sonar. Returns { answer, citations: [{index, url, title}], model, query }. Use for time-sensitive facts, library changelogs, docs lookups, and anything training data may not cover. Always cite the returned sources.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Search query."
            },
            "recency": {
              "description": "Only include results from the last day/week/month/year.",
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            },
            "mode": {
              "description": "Search corpus. Defaults to web.",
              "type": "string",
              "enum": [
                "web",
                "academic",
                "sec"
              ]
            },
            "domains": {
              "description": "Optional allow-list of domains (e.g. ['docs.python.org']). Prefix with '-' to exclude.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "max_results": {
              "description": "Approximate max sources to consider (default 8).",
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "model": {
              "description": "Perplexity model. Defaults to your configured web-search model.",
              "type": "string",
              "enum": [
                "sonar",
                "sonar-pro",
                "sonar-reasoning",
                "sonar-reasoning-pro"
              ]
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "conductor_route",
        "title": "Conductor — routing plan only",
        "description": "Ask the Conductor which agents SHOULD answer a prompt and why, without fanning out. Cheap — use to preview a plan before spending tokens with conductor_ask or conductor_debate.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "description": "The prompt to plan for."
            },
            "conductor_platform": {
              "description": "Which model plans the route.",
              "type": "string",
              "enum": [
                "openai",
                "anthropic",
                "google",
                "grok",
                "deepseek",
                "perplexity",
                "mistral",
                "qwen",
                "nvidia"
              ]
            },
            "include_platforms": {
              "description": "Candidate agents to choose from.",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic",
                  "google",
                  "grok",
                  "deepseek",
                  "perplexity",
                  "mistral",
                  "qwen",
                  "nvidia"
                ]
              }
            }
          },
          "required": [
            "prompt"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "conductor_compare",
        "title": "Conductor — raw multi-model perspectives",
        "description": "Fan the prompt out to the panel and return each agent's raw answer side-by-side, WITHOUT a synthesis step. Use to compare or benchmark models yourself. Cheaper than conductor_ask.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "description": "The prompt to send to every agent."
            },
            "include_platforms": {
              "description": "Which agents to compare.",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic",
                  "google",
                  "grok",
                  "deepseek",
                  "perplexity",
                  "mistral",
                  "qwen",
                  "nvidia"
                ]
              }
            },
            "conversation_id": {
              "description": "Optional existing conversation to continue.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "prompt"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "conductor_ask",
        "title": "Conductor — orchestrated multi-model answer",
        "description": "Run RoboHeard's Conductor: one model routes the prompt across a panel of frontier AIs, collects their perspectives, and synthesizes a single best answer. Prefer this over ask_model when the question is ambiguous, high-stakes, or spans multiple domains. Persists to chat history.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "description": "The user prompt to route across the panel."
            },
            "conductor_platform": {
              "description": "Which model plays Conductor. Defaults to your configured one.",
              "type": "string",
              "enum": [
                "openai",
                "anthropic",
                "google",
                "grok",
                "deepseek",
                "perplexity",
                "mistral",
                "qwen",
                "nvidia"
              ]
            },
            "include_platforms": {
              "description": "Restrict the panel. Defaults to 4 frontier models.",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic",
                  "google",
                  "grok",
                  "deepseek",
                  "perplexity",
                  "mistral",
                  "qwen",
                  "nvidia"
                ]
              }
            },
            "conversation_id": {
              "description": "Optional existing conversation to continue.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "prompt"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "conductor_debate",
        "title": "Conductor — multi-round critique loop",
        "description": "Run the Conductor N times in a critique-and-improve loop, ending with a final synthesized answer. Use for hard reasoning, code review, or architecture decisions. Slower and consumes more tokens.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "description": "The problem to work through."
            },
            "iterations": {
              "description": "Number of rounds (default 3).",
              "type": "integer",
              "minimum": 2,
              "maximum": 5
            },
            "conductor_platform": {
              "description": "Which model plays Conductor.",
              "type": "string",
              "enum": [
                "openai",
                "anthropic",
                "google",
                "grok",
                "deepseek",
                "perplexity",
                "mistral",
                "qwen",
                "nvidia"
              ]
            },
            "include_platforms": {
              "description": "Restrict the panel.",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic",
                  "google",
                  "grok",
                  "deepseek",
                  "perplexity",
                  "mistral",
                  "qwen",
                  "nvidia"
                ]
              }
            },
            "conversation_id": {
              "description": "Optional existing conversation to continue.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "prompt"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
